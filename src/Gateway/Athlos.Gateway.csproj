<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ContainerRepository>athlos/gateway</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\Athlos.Tenancy\Athlos.Tenancy.csproj" />
    <ProjectReference Include="..\ServiceDefaults\Athlos.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- wwwroot holds the SPA's Vite build (npm run build in src/web) and is not committed.
       Create it empty so the gateway also runs, and its tests pass, without a SPA build. -->
  <Target Name="EnsureWwwroot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
  </Target>

</Project>
