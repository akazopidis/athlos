{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "plans": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/plans/{**rest}"
        }
      },
      "tenants": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/tenants/{**rest}"
        }
      },
      "me-memberships": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me/memberships"
        }
      },
      "me-profile": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me/profile"
        }
      },
      "marketplace-coaches": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/marketplace/coaches/{**rest}"
        }
      },
      "studio-workspace": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/workspace"
        }
      }
    },
    "Clusters": {
      "tenancy": {
        "Destinations": {
          "tenancy-api": {
            "Address": "https+http://tenancy-api"
          }
        }
      }
    }
  }
}
