{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "plans": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/plans/{**rest}"
        }
      },
      "invites": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/invites/{**rest}"
        }
      },
      "studio-invites": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/invites/{**rest}"
        }
      },
      "studio-members": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/members/{**rest}"
        }
      },
      "tenants": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/tenants/{**rest}"
        }
      },
      "admin": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/admin/{**rest}"
        }
      },
      "admin-payouts": {
        "ClusterId": "ordering",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/admin/payouts/{**rest}"
        }
      },
      "me-memberships": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me/memberships"
        }
      },
      "me-account": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me",
          "Methods": [
            "DELETE"
          ]
        }
      },
      "me-profile": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me/profile"
        }
      },
      "marketplace-coach-list": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/marketplace/coaches",
          "Methods": [
            "GET"
          ]
        }
      },
      "marketplace-coaches": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/marketplace/coaches/{**rest}"
        }
      },
      "studio-workspace": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/workspace/{**rest}"
        }
      },
      "marketplace-program-reviews": {
        "ClusterId": "enrollment",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/marketplace/programs/{programId}/reviews"
        }
      },
      "studio-reviews": {
        "ClusterId": "enrollment",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/reviews/{**rest}"
        }
      },
      "marketplace-programs": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/marketplace/programs/{**rest}"
        }
      },
      "marketplace-coach-programs": {
        "ClusterId": "catalog",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/marketplace/coaches/{coachSlug}/programs/{**rest}"
        }
      },
      "studio-programs": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/programs/{**rest}"
        }
      },
      "studio-payouts": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/payouts/{**rest}"
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/orders/{**rest}"
        }
      },
      "me-orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/me/orders/{**rest}"
        }
      },
      "me-saved": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/me/saved/{**rest}"
        }
      },
      "me-programs": {
        "ClusterId": "enrollment",
        "Match": {
          "Path": "/api/v1/me/programs/{**rest}"
        }
      },
      "studio-sales": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/sales/{**rest}"
        }
      },
      "studio-discounts": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/discounts/{**rest}"
        }
      },
      "stripe-webhook": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/webhooks/stripe",
          "Methods": [
            "POST"
          ]
        }
      },
      "stripe-connect-webhook": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/webhooks/stripe-connect",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "tenancy": {
        "Destinations": {
          "tenancy-api": {
            "Address": "https+http://tenancy-api"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "catalog-api": {
            "Address": "https+http://catalog-api"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering-api": {
            "Address": "https+http://ordering-api"
          }
        }
      },
      "enrollment": {
        "Destinations": {
          "enrollment-api": {
            "Address": "https+http://enrollment-api"
          }
        }
      }
    }
  }
}
