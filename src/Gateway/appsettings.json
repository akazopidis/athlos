{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "plans": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/plans/{**rest}"
        }
      },
      "tenants": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/tenants/{**rest}"
        }
      },
      "me-memberships": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me/memberships"
        }
      },
      "me-profile": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/me/profile"
        }
      },
      "marketplace-coaches": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/marketplace/coaches/{**rest}"
        }
      },
      "studio-workspace": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/workspace"
        }
      },
      "marketplace-programs": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/marketplace/programs/{**rest}"
        }
      },
      "marketplace-coach-programs": {
        "ClusterId": "catalog",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/marketplace/coaches/{coachSlug}/programs/{**rest}"
        }
      },
      "studio-programs": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/programs/{**rest}"
        }
      },
      "studio-payouts": {
        "ClusterId": "tenancy",
        "Match": {
          "Path": "/api/v1/studio/{tenantSlug}/payouts/{**rest}"
        }
      }
    },
    "Clusters": {
      "tenancy": {
        "Destinations": {
          "tenancy-api": {
            "Address": "https+http://tenancy-api"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "catalog-api": {
            "Address": "https+http://catalog-api"
          }
        }
      }
    }
  }
}
