{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "plans": {
        "ClusterId": "tenancy",
        "Match": { "Path": "/api/v1/plans/{**rest}" }
      }
    },
    "Clusters": {
      "tenancy": {
        "Destinations": {
          "tenancy-api": { "Address": "https+http://tenancy-api" }
        }
      }
    }
  }
}
