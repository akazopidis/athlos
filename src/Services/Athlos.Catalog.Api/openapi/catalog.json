  "components": {
    "schemas": {
      "CreateProgramRequest": {
        "required": [
          "slug",
          "title",
          "description",
          "category",
          "durationWeeks",
          "priceAmount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "maxLength": 60,
            "minLength": 3,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/ProgramCategory"
          },
          "durationWeeks": {
            "maximum": 52,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "priceAmount": {
            "maximum": 1000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        }
      },
      "GetPublishedProgramResponse": {
        "required": [
          "id",
