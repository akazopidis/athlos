          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ProgramCategory": {
        "enum": [
          "GeneralFitness",
          "Bodybuilding",
          "Powerlifting",
          "CrossFit",
          "Weightlifting",
          "Calisthenics",
          "Running",
          "Mobility"
        ]
      },
      "ProgramDetails": {
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "category",
          "durationWeeks",
          "priceAmount",
          "currency",
          "isPublished",
