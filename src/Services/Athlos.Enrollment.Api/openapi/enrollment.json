        "required": [
          "programId",
          "programTitle",
          "coachSlug",
          "enrolledAt",
          "completedWorkouts"
        ],
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "format": "uuid"
          },
          "programTitle": {
            "type": "string"
