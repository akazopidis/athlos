{
  "openapi": "3.1.1",
  "info": {
    "title": "Athlos.Enrollment.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/me/programs": {
      "get": {
        "tags": [
          "My programs"
        ],
        "operationId": "ListMyPrograms",
        "parameters": [
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "maximum": 10000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyEnrollmentsMyProgramsPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/programs/{programId}": {
      "get": {
        "tags": [
          "My programs"
        ],
        "operationId": "GetMyProgram",
        "parameters": [
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMyProgramResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/me/programs/{programId}/workouts/{workoutId}/completion": {
      "put": {
        "tags": [
          "My programs"
        ],
        "operationId": "CompleteWorkout",
        "parameters": [
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "workoutId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "My programs"
        ],
        "operationId": "UndoWorkoutCompletion",
        "parameters": [
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "workoutId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMyProgramResponse": {
        "required": [
          "programId",
          "coachSlug",
          "title",
          "description",
          "category",
          "durationWeeks",
          "coverImageUrl",
          "enrolledAt",
          "workouts"
        ],
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "format": "uuid"
          },
          "coachSlug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "durationWeeks": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "coverImageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "enrolledAt": {
            "type": "string",
            "format": "date-time"
          },
          "workouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetMyProgramWorkout"
            }
          }
        }
      },
      "GetMyProgramWorkout": {
        "required": [
          "id",
          "week",
          "day",
          "title",
          "content",
          "videoUrl",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "week": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "day": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "videoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "MyEnrollmentsMyProgram": {
        "required": [
          "programId",
          "programTitle",
          "coachSlug",
          "enrolledAt",
          "completedWorkouts"
        ],
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "format": "uuid"
          },
          "programTitle": {
            "type": "string"
          },
          "coachSlug": {
            "type": "string"
          },
          "enrolledAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedWorkouts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "MyEnrollmentsMyProgramsPage": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyEnrollmentsMyProgram"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "My programs"
    }
  ]
}