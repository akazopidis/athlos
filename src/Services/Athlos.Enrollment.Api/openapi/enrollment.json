    "/api/v1/studio/{tenantSlug}/reviews/{reviewId}/reply": {
      "put": {
        "tags": [
          "Reviews"
        ],
        "operationId": "ReplyToReview",
        "parameters": [
          {
            "name": "tenantSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
