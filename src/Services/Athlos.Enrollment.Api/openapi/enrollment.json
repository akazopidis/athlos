      "StudioReviewsItem": {
        "required": [
          "id",
          "programId",
          "programTitle",
          "rating",
          "comment",
          "authorName",
          "createdAt",
          "updatedAt",
          "reply",
          "repliedAt"
        ],
        "type": "object",
        "properties": {
