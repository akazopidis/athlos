              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTenantResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invites/{tenantSlug}/accept": {
      "post": {
        "tags": [
          "Team"
        ],
        "operationId": "AcceptStaffInvite",
