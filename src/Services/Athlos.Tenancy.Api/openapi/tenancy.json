              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutEndpointsPayoutStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/studio/{tenantSlug}/invites": {
      "get": {
        "tags": [
          "Team"
        ],
        "operationId": "ListStaffInvites",
        "parameters": [
          {
            "name": "tenantSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StaffInvitesInvite"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "post": {
        "tags": [
          "Team"
        ],
        "operationId": "CreateStaffInvite",
        "parameters": [
          {
            "name": "tenantSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffInvitesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffInvitesInvite"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/studio/{tenantSlug}/invites/{inviteId}": {
      "delete": {
        "tags": [
          "Team"
        ],
        "operationId": "RevokeStaffInvite",
        "parameters": [
          {
            "name": "tenantSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inviteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptInviteRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "AcceptInviteResponse": {
        "required": [
          "slug",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Branding": {
        "type": "object",
        "properties": {
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "primaryColor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateTenantRequest": {
        "required": [
          "slug",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "maxLength": 40,
            "minLength": 3,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "CreateTenantResponse": {
        "required": [
          "id",
          "slug",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "DeleteWorkspaceRequest": {
        "required": [
          "confirmSlug"
        ],
        "type": "object",
        "properties": {
          "confirmSlug": {
            "type": "string"
          }
        }
      },
      "GetStorefrontResponse": {
        "required": [
          "slug",
          "displayName",
          "branding"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "branding": {
            "$ref": "#/components/schemas/Branding"
          }
        }
      },
      "GetWorkspaceResponse": {
        "required": [
          "id",
          "slug",
          "displayName",
          "status",
          "plan",
          "branding",
          "stripeOnboardingComplete"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          },
          "plan": {
            "$ref": "#/components/schemas/PlanName"
          },
          "branding": {
            "$ref": "#/components/schemas/Branding"
          },
          "stripeOnboardingComplete": {
            "type": "boolean"
          }
        }
      },
      "ListMyMembershipsItem": {
        "required": [
          "tenantId",
          "slug",
          "displayName",
          "role"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          }
        }
      },
      "PayoutEndpointsOnboardingLink": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "PayoutEndpointsPayoutStatus": {
        "required": [
          "connected",
          "onboardingComplete",
          "payoutsEnabled"
        ],
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "onboardingComplete": {
            "type": "boolean"
          },
          "payoutsEnabled": {
            "type": "boolean"
          }
        }
      },
      "Plan": {
        "required": [
          "name",
          "requestsPerSecond",
          "maxPrograms",
          "maxStaff",
          "maxMediaGigabytes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/PlanName"
          },
          "requestsPerSecond": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxPrograms": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxStaff": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxMediaGigabytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PlanName": {
        "enum": [
          "Free",
          "Pro"
        ]
      },
      "StaffInvitesInvite": {
        "required": [
          "id",
          "email",
          "expiresAt",
          "expired"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "expired": {
            "type": "boolean"
          }
        }
      },
      "StaffInvitesRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "TenantRole": {
        "enum": [
          "Owner",
          "Staff"
        ]
      },
      "TenantStatus": {
        "enum": [
          "Active",
          "Suspended",
          "Deleted"
        ]
      },
      "UpdateWorkspaceRequest": {
        "required": [
          "displayName",
          "logoUrl",
          "primaryColor"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "logoUrl": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          },
          "primaryColor": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpsertMyProfileResponse": {
        "required": [
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Plans"
    },
    {
      "name": "Tenants"
    },
    {
      "name": "Team"
    },
    {
      "name": "Marketplace"
    },
    {
      "name": "Account"
    },
    {
      "name": "Workspace"
    },
    {
      "name": "Payouts"
    }
  ]
}