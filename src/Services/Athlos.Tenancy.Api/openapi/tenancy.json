              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListMyMembershipsItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/profile": {
      "put": {
        "tags": [
          "Account"
        ],
        "operationId": "UpsertMyProfile",
        "responses": {
          "200": {
            "description": "OK",
